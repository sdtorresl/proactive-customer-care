# --- Database ---
DATABASE_URL=postgresql://proactive-customer-care:proactive-customer-care@db:5432/proactive-customer-care

# --- Zendesk ---
ZENDESK_SUBDOMAIN=tuempresa
# OAuth client_credentials credentials (Admin Center > Apps and integrations > OAuth clients)
ZENDESK_CLIENT_ID=tu_client_id
ZENDESK_CLIENT_SECRET=tu_client_secret
ZENDESK_OAUTH_SCOPE=tickets:write
ZENDESK_TICKET_PRIORITY=high

# --- SendGrid ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=alerts@proactive-customer-care.com
SENDGRID_FROM_NAME=proactive-customer-care Monitoring

# --- Analysis window and anomaly thresholds ---
# How many hours back to analyze on each run
LOOKBACK_HOURS=1
# How many historical runs to use as the baseline (average/standard deviation)
BASELINE_WINDOW=24
# Percentage increase over the baseline at which an anomaly is considered
ANOMALY_PCT_THRESHOLD=50
# Minimum error count for a relevant anomaly (avoids 1-2 error noise)
ANOMALY_MIN_COUNT=5
# Number of consecutive increasing runs required for escalation (detects a real sustained increase, not an isolated spike)
ANOMALY_MIN_STREAK=2
# Minimum hours between Zendesk tickets for the same client/error (avoids duplicates)
INCIDENT_COOLDOWN_HOURS=12

# --- Client configuration ---
CLIENTS_CONFIG_PATH=/app/clients.json

# --- Periodic execution ---
# RUN_MODE=loop runs in a loop inside the container every LOOP_INTERVAL_SECONDS.
# RUN_MODE=once runs once (use with host cron or an external scheduler).
RUN_MODE=loop
# Interval between runs in loop mode, in seconds (60 = every minute)
LOOP_INTERVAL_SECONDS=60
