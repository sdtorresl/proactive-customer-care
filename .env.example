# --- Base de datos ---
DATABASE_URL=postgresql://proactive-customer-care:proactive-customer-care@db:5432/proactive-customer-care

# --- Zendesk ---
ZENDESK_SUBDOMAIN=tuempresa
# Credenciales OAuth client_credentials (Admin Center > Apps y integraciones > OAuth clients)
ZENDESK_CLIENT_ID=tu_client_id
ZENDESK_CLIENT_SECRET=tu_client_secret
ZENDESK_OAUTH_SCOPE=tickets:write
ZENDESK_TICKET_PRIORITY=high

# --- SendGrid ---
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=alerts@proactive-customer-care.com
SENDGRID_FROM_NAME=proactive-customer-care Monitoring

# --- Ventana de análisis y umbrales de anomalía ---
# Cuántas horas hacia atrás se analizan en cada corrida
LOOKBACK_HOURS=1
# Cuántas corridas históricas se usan como línea base (promedio/desv. estándar)
BASELINE_WINDOW=24
# % de incremento sobre la línea base a partir del cual se considera anomalía
ANOMALY_PCT_THRESHOLD=50
# Conteo mínimo de errores para considerar la anomalía relevante (evita ruido con 1-2 errores)
ANOMALY_MIN_COUNT=5
# Nº de corridas consecutivas con tendencia al alza requeridas para escalar (detecta "subida creciente" real, no un pico aislado)
ANOMALY_MIN_STREAK=2
# Horas mínimas entre dos tickets de Zendesk para el mismo cliente/error (evita duplicados)
INCIDENT_COOLDOWN_HOURS=12

# --- Configuración de clientes ---
CLIENTS_CONFIG_PATH=/app/clients.json

# --- Ejecución periódica ---
# RUN_MODE=loop corre en bucle dentro del contenedor cada LOOP_INTERVAL_SECONDS.
# RUN_MODE=once ejecuta una sola vez (usar con cron del host o un scheduler externo).
RUN_MODE=loop
# Intervalo entre corridas en modo loop, en segundos (60 = cada minuto)
LOOP_INTERVAL_SECONDS=60
